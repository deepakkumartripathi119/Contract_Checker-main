# ============================================================
# Contract Checker — environment template
# Copy this to .env and fill in the real keys.
# Never commit .env.
# ============================================================

# --- Model --------------------------------------------------------------
# Supported providers: groq | gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# --- API keys -----------------------------------------------------------
GROQ_API_KEY=your_groq_key_here
COHERE_API_KEY=your_cohere_key_here
GOOGLE_API_KEY=your_google_key_here
# OPENAI_API_KEY=your_openai_key_here

# --- Company login ------------------------------------------------------
# Signs the token from /v1/register and /v1/login. Required for the dashboard.
JWT_SECRET=change-me

# --- Company and policy store ------------------------------------------
# Streamlit still uses this id when you type nothing. The dashboard uses the login token.
POLICY_ORG_ID=your_org_id
# Unconfigured companies use this when the policy is silent. A saved company row is not overwritten.
DEFAULT_SILENT_POLICY_BEHAVIOR=review_required

# Supported: sqlite | pgvector
# pgvector uses DATABASE_URL. sqlite uses SQLITE_DB_PATH.
VECTOR_STORE_BACKEND=sqlite
SQLITE_DB_PATH=data/contract_checker.db
DATABASE_URL=postgresql+psycopg://contract:contract@localhost:5432/contract_checker

# --- Original files -----------------------------------------------------
# local writes a folder. s3 uses the S3 API for MinIO or AWS. The database stores the key only.
OBJECT_STORE_BACKEND=local
OBJECT_STORE_PATH=data/objects
# S3_BUCKET=contract-checker
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# --- Verdict cache ------------------------------------------------------
# Supported: sqlite | redis
# redis is selected in Docker. Leave CACHE_DB_PATH unset so a host run stays in SQLITE_DB_PATH.
CACHE_BACKEND=sqlite
# CACHE_DB_PATH=data/compliance_cache.db
# REDIS_URL=redis://127.0.0.1:6379/0
CACHE_SEMANTIC_THRESHOLD=0.95
COMPLIANCE_EVALUATION_VERSION=v1.0

# --- Checker ------------------------------------------------------------
ENABLE_MISSING_CLAUSE_CHECK=true
# Ask the model for a quoted coverage decision. false keeps the local word-overlap check.
USE_LLM_OBLIGATION_CHECK=false

# --- Retrieval ----------------------------------------------------------
RETRIEVAL_TOP_K=5
RRF_WEIGHT_DENSE=0.7
RRF_WEIGHT_SPARSE=0.3
RRF_K=60

# --- Reranker -----------------------------------------------------------
RERANKER_SKIP_THRESHOLD=0.005
RERANKER_RETRY_THRESHOLD=0.012
RERANKER_TOP_K=2
RERANKER_USE_COHERE=false

# --- LangSmith ----------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=contract-checker
