# ============================================================
# Contract Checker — Environment Variables
# Copy this to .env and fill in your real keys.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# --- LLM Provider -----------------------------------------------------------
# Switch the entire pipeline by changing ONE variable.
# Supported: groq | gemini | openai
LLM_PROVIDER=groq

# Model name for the chosen provider (optional — falls back to provider default)
# Groq default  : llama-3.1-8b-instant
# Gemini default: gemini-2.0-flash
# OpenAI default: gpt-4o-mini
LLM_MODEL=llama-3.1-8b-instant

# --- API Keys ---------------------------------------------------------------
GROQ_API_KEY=your_groq_key_here
COHERE_API_KEY=your_cohere_key_here
GOOGLE_API_KEY=your_google_key_here
OPENAI_API_KEY=your_openai_key_here   # only needed if LLM_PROVIDER=openai

# --- Vector Store -----------------------------------------------------------
# Swap the entire vector store backend by changing ONE variable.
# Supported: sqlite | pgvector (pgvector: not yet implemented)
VECTOR_STORE_BACKEND=sqlite

# Path to the SQLite database file (relative to project root)
SQLITE_DB_PATH=data/contract_checker.db

# --- Cache ------------------------------------------------------------------
# Swap cache backend by changing ONE variable.
# Supported: sqlite | redis (redis: not yet implemented)
CACHE_BACKEND=sqlite
CACHE_SEMANTIC_THRESHOLD=0.95

# --- Missing Clause Verification -------------------------------------------
ENABLE_MISSING_CLAUSE_CHECK=true

# --- Multi-tenant -----------------------------------------------------------
# Default org_id for local development.
# When multi-tenant auth is added, this will come from the JWT/session.
POLICY_ORG_ID=your_org_id

# --- Retrieval & RRF Tuning ------------------------------------------------
RETRIEVAL_TOP_K=5
RRF_WEIGHT_DENSE=0.7
RRF_WEIGHT_SPARSE=0.3
RRF_K=60

# --- Reranker 3-Zone Confidence Gate ---------------------------------------
RERANKER_SKIP_THRESHOLD=0.005
RERANKER_RETRY_THRESHOLD=0.012
RERANKER_TOP_K=2

# --- LangSmith Tracing (optional) ------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=contract-checker